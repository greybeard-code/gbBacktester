.venv/
.cache/
reports/
__pycache__/
*.pyc
.pytest_cache/

# Vendor binaries are NEVER committed — this repository is PUBLIC, and the NT8
# bar types/indicators snapshotted under "nt8 code/" are paid third-party
# products. Keep them locally for reference; the behaviour we actually depend
# on is captured in research/*_spec.md instead. Only Info.xml and NT8's empty
# generated export stub are tracked, to document the package shape.
# (SaberRenko.dll predates this rule and is already tracked and pushed;
# removing it needs a history rewrite.)
nt8 code/**/*.dll
nt8 code/**/*.zip
nt8 code/**/*.pdf

# Decompilations. NT8_Tbars is the TBars class with the license check
# stripped, circulated as if it were vendor source — it is not. Same policy as
# ninZaRenko; research/TBars_spec.md §0 records what it told us.
nt8 code/TBarsNew/NT8_Tbars/
nt8 code/TBarsNew/NT8_Tbars.zip

# Whole-DLL decompile of TBarsNEW (ILSpy project export). Most of it is NT8's
# OWN stock code that the vendor's NinjaScript export bundled in, and it does
# not even round-trip (the DrawingTools files emit CS1525 on 'ref').
nt8 code/TBarsNew/TBarsNEW/NinjaTrader.Custom/
nt8 code/TBarsNew/TBarsNEW/NinjaTrader.NinjaScript.*/
nt8 code/TBarsNew/TBarsNEW/Properties/
nt8 code/TBarsNew/TBarsNEW/NinjaTrader.Custom.Resource.resx
nt8 code/TBarsNew/TBarsNEW/TBarsNEW-cleaned.*

# Khahn's HiLoRider — a friend's PRIVATE strategy, shared directly rather than
# circulated publicly, so it is not ours to publish from a public repo (user
# decision 2026-08-11). Same "keep it locally, commit the analysis instead"
# treatment as the vendor binaries above: everything this repo actually depends
# on is written up in `nt8 code/HiLoRider/HiLoRider.md` and reimplemented from
# scratch in `strategies/hilo_rider.py`.
# NOTE the WaveBars/ sibling directory is deliberately NOT ignored — Wave Bars
# is FlowMatriX's own declared open-source bar type, and the two bar exports
# next to it are market data, not anyone's source.
nt8 code/HiLoRider/HiLoRider v1.0*/
nt8 code/HiLoRider/HiLoRiderTrainer.py
nt8 code/HiLoRider/HiLoRiderDashboardGenerator.py
